{
  "name": "Copiloto de Dados",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "postCreateCommand": "pip install -r requirements.txt && python -m pytest -q",
  "postAttachCommand": "nohup streamlit run app.py --server.port 8501 --server.headless true > /tmp/streamlit.log 2>&1 &",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Copiloto de Dados", "onAutoForward": "openBrowser" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
